# Copy to .env.local for local builds. On Vercel, set these in Project Settings → Environment Variables.

# Public origin used for canonical URLs, Open Graph, robots.txt and sitemap.xml (no trailing slash).
# If unset, the build falls back to https://$VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
SITE_URL=https://www.example.com

# "true" allows search engines to index the site. Leave "false" (or unset) for previews and until the
# business owner approves launch. The build fails if this is "true" while the site URL is localhost.
SITE_INDEXABLE=false
